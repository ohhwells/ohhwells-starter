# Set automatically by the OhhWells deploy pipeline — no manual config needed
# for a normal deploy. Only required for local dev against the canvas editor.

# Backend API — used by OhhwellsBridge to fetch/save saved content.
NEXT_PUBLIC_FLOWOPS_API_URL=

# Public URL of this deployed site. Set once at the project level;
# the bridge reads the current hostname at runtime, so don't hardcode this.
NEXT_PUBLIC_SITE_URL=
